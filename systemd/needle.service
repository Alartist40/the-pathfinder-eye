[Unit]
Description=THE-PATHFINDER-EYE Needle 2 Tool-Calling Engine (RAM-bound)
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/xander/Documents/portfolio/the-pathfinder-eye
ExecStart=/home/xander/Downloads/models/needle2/linux-arm64/needle --tools /home/xander/Documents/portfolio/the-pathfinder-eye/config/needle_tools.json --serve --port 8082
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
